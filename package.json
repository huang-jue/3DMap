{
  "name": "@sgyx/cesium-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "build:playground": "pnpm --filter playground build",
    "test": "pnpm --filter \"./packages/*\" test",
    "typecheck": "pnpm --workspace-concurrency=1 --filter \"./packages/*\" typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:preview": "pnpm --filter docs preview",
    "verify:pack": "node scripts/verify-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "publish:packages": "pnpm build && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "publish:dry-run": "pnpm build && pnpm -r --filter \"./packages/*\" publish --dry-run --access public --no-git-checks",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
