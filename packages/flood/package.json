    "gis",
    "3d",
    "map"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "cesium": "^1.146.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
