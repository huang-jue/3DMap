{
  "name": "@sgyx/cesium-kit-flood",
  "version": "0.1.0",
  "description": "Cesium 水旱灾害防御四预插件：数据底板、预报、预警、预演与预案",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huang-jue/3DMap.git",
    "directory": "packages/flood"
  },
  "homepage": "https://github.com/huang-jue/3DMap#readme",
  "bugs": {
    "url": "https://github.com/huang-jue/3DMap/issues"
  },
  "author": "cesium-kit contributors",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
